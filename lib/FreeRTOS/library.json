{
  "name": "FreeRTOS-Kernel",
  "version": "11.1.0",
  "description": "Official FreeRTOS kernel with GCC ARM_CM4F port and heap_4 allocator",
  "frameworks": ["stm32cube"],
  "platforms": ["ststm32"],
  "build": {
    "srcDir": ".",
    "includeDir": "include",
    "srcFilter": [
      "+<tasks.c>", "+<queue.c>", "+<list.c>", "+<timers.c>",
      "+<event_groups.c>", "+<stream_buffer.c>",
      "+<portable/GCC/ARM_CM4F/port.c>",
      "+<portable/MemMang/heap_4.c>"
    ]
  }
}
